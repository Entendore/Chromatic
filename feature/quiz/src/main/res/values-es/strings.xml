    <string name="lighter_prompt">¿Qué color es MÁS CLARO?</string>
    <string name="quiz_correct">Correcto — la diferencia se reduce la próxima ronda.</string>
    <string name="quiz_wrong">Casi — la diferencia se amplía para que sea justo. ΔL ≈ %1$s</string>

    <string name="q_prompt_harmony">Se muestran la muestra base y su pareja. ¿Qué armonía forman?</string>
    <string name="q_prompt_contrast">¿Qué combinación cumple WCAG AA para texto (4.5:1)? Se asume texto blanco.</string>
    <string name="q_prompt_shade">¿Qué muestra es una SOMBRA del color base?</string>
    <string name="q_prompt_warmer">¿Qué color es MÁS CÁLIDO?</string>
    <string name="q_prompt_saturation">¿Qué muestra tiene MAYOR saturación?</string>
    <string name="q_prompt_name">¿Cómo se llama este color?</string>
    <string name="q_prompt_lighter_inline">¿Qué color es más claro?</string>
    <string name="q_expl_harmony">Las parejas %1$s se sitúan a %2$s° en el círculo.</string>
    <string name="q_expl_contrast">El cociente es %1$s:1.</string>
    <string name="q_expl_shade">Una sombra mezcla negro — mismo tono y saturación, menor luminosidad.</string>
    <string name="q_expl_warmer">%1$s está en el lado rojo/naranja del círculo, que se percibe cálido; el cian/azul se percibe frío.</string>
    <string name="q_expl_saturation">Mismo tono, misma luminosidad — solo cambia el contenido de gris. La saturación es intensidad, no brillo.</string>
    <string name="q_expl_name">\"%1$s\" vive en el entorno del tono %2$s° — la familia de la muestra.</string>
