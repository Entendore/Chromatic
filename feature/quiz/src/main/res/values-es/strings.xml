    <string name="q_s1_prompt">En la regla 60-30-10, ¿qué papel suele jugar el \'10\'?</string>
    <string name="q_s1_a">El fondo dominante</string>
    <string name="q_s1_b">Un color secundario de apoyo</string>
    <string name="q_s1_c">El color de acento</string>
    <string name="q_s1_d">El color del texto</string>
    <string name="q_s1_expl">Cerca del 10% va al acento — a menudo el complementario. Su escasez es lo que lo hace destacar.</string>
    <string name="q_s2_prompt">¿Cuál es el contraste mínimo WCAG 2.1 AA para texto normal?</string>
    <string name="q_s2_a">3.0:1</string>
    <string name="q_s2_b">4.5:1</string>
    <string name="q_s2_c">7.0:1</string>
    <string name="q_s2_d">21:1</string>
    <string name="q_s2_expl">4.5:1 para texto normal; 3.0:1 para texto grande; 7.0:1 es la barra AAA.</string>
    <string name="q_s3_prompt">Mezclar dos pinturas complementarias produce…</string>
    <string name="q_s3_a">Un tono más brillante</string>
    <string name="q_s3_b">Un gris o marrón neutro</string>
    <string name="q_s3_c">El primario que faltaba</string>
    <string name="q_s3_d">Blanco puro</string>
    <string name="q_s3_expl">Los complementarios se anulan — por eso se neutralizan al mezclarse.</string>
    <string name="q_s4_prompt">El contraste simultáneo significa que la apariencia de un color cambia según…</string>
    <string name="q_s4_a">Sus vecinos</string>
    <string name="q_s4_b">El brillo de la pantalla</string>
    <string name="q_s4_c">Su nombre</string>
    <string name="q_s4_d">La temperatura ambiente</string>
    <string name="q_s4_expl">El mismo gris se ve más claro sobre negro y más oscuro sobre blanco — juzga los colores siempre en contexto.</string>
    <string name="q_s5_prompt">¿Cuál de estas NO es una armonía clásica del color?</string>
    <string name="q_s5_a">Análoga</string>
    <string name="q_s5_b">Tetrádica</string>
    <string name="q_s5_c">Isobárica</string>
    <string name="q_s5_d">Monocromática</string>
    <string name="q_s5_expl">Isobárica pertenece a la termodinámica, no a la teoría del color.</string>
    <string name="q_s6_prompt">Las pantallas producen color…</string>
    <string name="q_s6_a">Absorbiendo luz como la tinta</string>
    <string name="q_s6_b">Sumando luz (RGB)</string>
    <string name="q_s6_c">Reflejando pigmento</string>
    <string name="q_s6_d">Polarizando fotones</string>
    <string name="q_s6_expl">Las pantallas son aditivas (RGB); la pintura y la imprenta, sustractivas (CMY). ¡Las reglas de mezcla difieren!</string>
