    <string name="q_prompt_harmony">The base swatch and its partner are shown. Which harmony do they form?</string>
    <string name="q_prompt_contrast">Which pairing passes WCAG AA for body text (4.5:1)? White text assumed.</string>
    <string name="q_prompt_shade">Which swatch is a SHADE of the base color?</string>
    <string name="q_prompt_warmer">Which color is WARMER?</string>
    <string name="q_prompt_saturation">Which swatch has HIGHER saturation?</string>
    <string name="q_prompt_name">What is this color called?</string>
    <string name="q_prompt_lighter_inline">Which color is lighter?</string>
    <string name="q_expl_harmony">%1$s partners sit %2$s° apart on the wheel.</string>
    <string name="q_expl_contrast">The ratio is %1$s:1.</string>
    <string name="q_expl_shade">A shade mixes in black — same hue and saturation, lower lightness.</string>
    <string name="q_expl_warmer">%1$s sits on the red/orange side of the wheel, which reads as warm; cyan/blue reads as cool.</string>
    <string name="q_expl_saturation">Same hue, same lightness — only the gray content differs. Saturation is intensity, not brightness.</string>
    <string name="q_expl_name">\"%1$s\" lives in the %2$s° hue neighborhood — the swatch\'s family.</string>
