    <!-- Static bank (v16 §2) -->
    <string name="q_s1_prompt">In the 60-30-10 rule, what role does the \'10\' usually play?</string>
    <string name="q_s1_a">The dominant background</string>
    <string name="q_s1_b">A secondary support color</string>
    <string name="q_s1_c">The accent color</string>
    <string name="q_s1_d">Body text color</string>
    <string name="q_s1_expl">About 10% goes to the accent — often the complement. Its scarcity is what makes it pop.</string>
    <string name="q_s2_prompt">What is the WCAG 2.1 AA minimum contrast ratio for body text?</string>
    <string name="q_s2_a">3.0:1</string>
    <string name="q_s2_b">4.5:1</string>
    <string name="q_s2_c">7.0:1</string>
    <string name="q_s2_d">21:1</string>
    <string name="q_s2_expl">4.5:1 for normal text; 3.0:1 for large text; 7.0:1 is the AAA bar.</string>
    <string name="q_s3_prompt">Mixing two complementary paint colors produces…</string>
    <string name="q_s3_a">A brighter hue</string>
    <string name="q_s3_b">A neutral gray or brown</string>
    <string name="q_s3_c">The missing primary</string>
    <string name="q_s3_d">Pure white</string>
    <string name="q_s3_expl">Complements cancel each other — that\'s why they neutralize when mixed.</string>
    <string name="q_s4_prompt">Simultaneous contrast means a color\'s appearance shifts based on…</string>
    <string name="q_s4_a">Its neighbors</string>
    <string name="q_s4_b">Screen brightness</string>
    <string name="q_s4_c">Its name</string>
    <string name="q_s4_d">Ambient temperature</string>
    <string name="q_s4_expl">The same gray looks lighter on black and darker on white — always judge colors in context.</string>
    <string name="q_s5_prompt">Which of these is NOT a classic color harmony?</string>
    <string name="q_s5_a">Analogous</string>
    <string name="q_s5_b">Tetradic</string>
    <string name="q_s5_c">Isobaric</string>
    <string name="q_s5_d">Monochromatic</string>
    <string name="q_s5_expl">Isobaric belongs to thermodynamics, not color theory.</string>
    <string name="q_s6_prompt">Screens produce color by…</string>
    <string name="q_s6_a">Absorbing light like ink</string>
    <string name="q_s6_b">Adding light (RGB)</string>
    <string name="q_s6_c">Reflecting pigment</string>
    <string name="q_s6_d">Polarizing photons</string>
    <string name="q_s6_expl">Displays are additive (RGB); paint and print are subtractive (CMY). Mixing rules differ!</string>
